                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "rule": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "gate",
                        "severity",
                        "message"
                      ],
                      "type": "object"

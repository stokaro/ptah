  {
    "name": "inference_plan",
    "description": "Explain what changing an embedding model would do to one of the operator's configured databases: the steps, what blocks them, what each answer rests on and where it came from, and what text would leave the database for the embedding endpoint. Reads catalogs and run state; creates nothing and writes nothing. Returns no source rows and no vectors.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "description": "identity of the generation queries read now, when there is one",
          "type": "string"
        },
        "spec": {
          "description": "path to the embedding-migration specification, inside a configured source root",
          "type": "string"
        },
        "target": {
          "description": "name of a configured database target; omit when the process has exactly one",
          "type": "string"
        }
      },
      "required": [

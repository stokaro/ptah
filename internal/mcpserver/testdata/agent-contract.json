  {
    "name": "preview_patch",
    "description": "Validate a proposed change to migration, schema or test files and return what applying it would do: a unified diff per file, the resulting digest, the capabilities it needs, and a preview token. Writes nothing. Apply the patch with apply_patch and the token this returns.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "description": "artifact class to change: migrations, schema or tests",
          "type": "string"
        },
        "changes": {
          "description": "the file changes to make",
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "description": "the complete file content for create and update",
                "type": "string"
              },
              "expected_digest": {
                "description": "sha256 digest of the file this change replaces",
                "type": "string"
              },
              "operation": {
                "description": "create, update or delete",
                "type": "string"
              },
              "path": {
                "description": "path relative to the artifact directory, using forward slashes",
                "type": "string"
              }
            },
            "required": [
              "path",
              "operation"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "expected_digest": {
          "description": "the artifact digest this patch was composed against",
          "type": "string"
        },
        "summary": {
          "description": "a short description of what this patch is for",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "changes"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        },
        "base_digest": {
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "expires_at": {
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "after_digest": {
                "type": "string"
              },
              "before_digest": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "diff": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "operation",
              "bytes",
              "diff"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "integrity_refresh": {
          "type": "boolean"
        },
        "notice": {
          "type": "string"
        },
        "patch_id": {
          "type": "string"
        },
        "preview_token": {
          "type": "string"
        },
        "requires_approval": {
          "type": "boolean"
        },
        "result_digest": {
          "type": "string"
        }
      },
      "required": [
        "patch_id",
        "artifact",
        "base_digest",
        "result_digest",
        "files",
        "capabilities",
        "preview_token",
        "expires_at",
        "requires_approval",
        "integrity_refresh",
        "notice"
      ],
      "type": "object"
    }

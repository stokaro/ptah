  {
    "name": "apply_patch",
    "description": "Apply a patch that preview_patch returned a token for. Ptah checks that the artifact has not changed since the preview, asks for approval where policy requires it, writes atomically, refreshes migration integrity metadata, runs its verification gates, and undoes the whole patch if the write introduced an error. The token is single-use.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "patch_id": {
          "description": "the patch_id returned alongside the preview token",
          "type": "string"
        },
        "preview_token": {
          "description": "the preview_token returned by preview_patch",
          "type": "string"
        }
      },
      "required": [
        "preview_token",
        "patch_id"
      ],
      "type": "object"
    },

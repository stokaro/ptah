### go.5x5.cz/ptah/migration/migrator.AtlasCheckpointTxtarConflictError

package migrator // import "go.5x5.cz/ptah/migration/migrator"

type AtlasCheckpointTxtarConflictError struct {
    // Path is the migration file that declares both directives.
    Path string
}
    AtlasCheckpointTxtarConflictError reports a migration file whose leading
    directive block declares both `-- atlas:checkpoint` and `-- atlas:txtar`.
    Measured Atlas checkpoints are plain single-statement-stream SQL files,
    so the combination has no measured semantics to mirror; executing either
    interpretation could silently run the wrong SQL, so the file is rejected.

func (e *AtlasCheckpointTxtarConflictError) Error() string

### go.5x5.cz/ptah/migration/migrator.AtlasDownNotImplementedError

package migrator // import "go.5x5.cz/ptah/migration/migrator"

type AtlasDownNotImplementedError struct {
    Version     int64
    Description string
}
    AtlasDownNotImplementedError reports an Atlas migration that lacks an
    embedded down.sql section. Ptah does not yet synthesize Atlas dynamic down
    plans from the current database state and a dev database.


# The environment the committed Graphviz SVGs are rendered in.
#
# Two independent variables decide those bytes, and pinning either alone is not
# enough. The file records the first itself -- `<!-- Generated by graphviz
# version ... -->` -- and the second is the installed FONTS: measured on one
# Alpine at one Graphviz version, the same DOT rendered 928pt wide with no font
# package and 1002pt with font-dejavu present (stokaro/ptah#2931).
#
# So both are pinned here, together, and they move when this file moves rather
# than when someone's distribution rotates a package. There is no maintained,
# version-tagged Graphviz image to pin instead: `alpine/graphviz` does not
# exist, `nshine/dot` publishes only `latest` and carries a 2018 build, and the
# upstream `graphviz/graphviz` image is a Windows build toolchain last tagged in
# 2021.
#
# The base is pinned by digest rather than by tag. Alpine rotates patch releases
# inside a stable branch, so `alpine:3.22` is a moving target and its `graphviz`
# package moves with it -- which would change the committed bytes without
# changing this file. Renovate tracks the digest.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# font-dejavu is not decoration. Graphviz measures every label to lay the graph
# out, so the fonts present decide the coordinates in the output, and a renderer
# with no fonts at all produces a different diagram rather than an unstyled one.
RUN apk add --no-cache graphviz font-dejavu

# No ENTRYPOINT. The caller names the Graphviz program it wants -- `dot` today,
# and the same image answers `neato` or `twopi` without a second definition.

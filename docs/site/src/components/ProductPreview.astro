---
/**
 * A figure with an image on the code surface, a bar with
 * a label and the actions, a caption, and an optional command that
 * reproduces the image (stokaro/ptah#2893, concept 1a). The styles are in
 * src/styles/ptah/figures.css.
 *
 * The class names and `data-*` attributes are a contract with the gates:
 * scripts/check-public-docs.mjs finds the figure by `data-visual-id`, requires
 * exactly one link per `data-preview-action` (full-size, download, source) and
 * follows every `href` inside the figure; scripts/check-visual-snapshots.mjs
 * reads the figcaption's text for the expected caption and each variant by
 * `data-preview-variant`. Rename nothing here without changing them.
 */
import { Image } from 'astro:assets';

interface Props {
  id: string;
  label?: string;
  themeWithSite?: boolean;
  src: ImageMetadata | string;
  darkSrc?: ImageMetadata | string;
  alt: string;
  caption: string;
  notice: string;
  fullSizeHref: string;
  downloadHref?: string;
  sourceHref?: string;
  reproduce?: string;
  variants?: Array<{
    id: string;
    label: string;
    src: ImageMetadata | string;
    darkSrc?: ImageMetadata | string;
    alt: string;
    fullSizeHref: string;
    downloadHref?: string;
    sourceHref?: string;
  }>;
}

const {
  id,
  label = 'Product output',
  themeWithSite = false,
  src,
  darkSrc,
  alt,
  caption,
  notice,
  fullSizeHref,
  downloadHref,
  sourceHref,
  reproduce,
  variants = [],
} = Astro.props;
---

<figure
  class="ptah-product-preview"
  data-product-preview
  data-visual-id={id}
  data-site-themed={themeWithSite ? '' : undefined}
  data-light-src={themeWithSite ? fullSizeHref : undefined}
  data-dark-src={themeWithSite && darkSrc ? (typeof darkSrc === 'string' ? darkSrc : darkSrc.src) : undefined}
>
  <div class="ptah-product-preview__bar">
    <span class="ptah-product-preview__label">{label}</span>
    <nav class="ptah-product-preview__actions" aria-label={`${caption} actions`}>
      <a href={fullSizeHref} data-preview-action="full-size">Full size</a>
      {downloadHref && <a href={downloadHref} download data-preview-action="download">Download</a>}
      {sourceHref && <a href={sourceHref} data-preview-action="source">Source</a>}
    </nav>
  </div>

  <a
    class="ptah-product-preview__media"
    href={fullSizeHref}
    data-preview-action="full-size-media"
    aria-label={`Open the full-size ${caption}`}
  >
    {themeWithSite && darkSrc ? (
      <img
        data-themed-diagram
        src={typeof src === 'string' ? src : src.src}
        width={typeof src === 'string' ? undefined : src.width}
        height={typeof src === 'string' ? undefined : src.height}
        alt={alt}
        loading="eager"
      />
    ) : darkSrc ? (
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset={typeof darkSrc === 'string' ? darkSrc : darkSrc.src} />
        <Image src={src} alt={alt} loading="eager" />
      </picture>
    ) : (
      <Image src={src} alt={alt} loading="eager" />
    )}
  </a>

  <figcaption>
    <p class="ptah-product-preview__caption">{caption}</p>
    <p class="ptah-product-preview__notice"><strong>What to notice:</strong> {notice}</p>

    {reproduce && (
      <details class="ptah-product-preview__reproduce">
        <summary>Reproduce this output</summary>
        <pre><code>{reproduce}</code></pre>
      </details>
    )}

    {variants.length > 0 && (
      <div class="ptah-product-preview__variants" aria-label={`${caption} variants`}>
        {variants.map((variant) => (
          <article data-preview-variant={variant.id}>
            <a href={variant.fullSizeHref} aria-label={`Open the full-size ${variant.label}`}>
              {variant.darkSrc ? (
                <picture>
                  <source media="(prefers-color-scheme: dark)" srcset={typeof variant.darkSrc === 'string' ? variant.darkSrc : variant.darkSrc.src} />
                  <Image src={variant.src} alt={variant.alt} loading="lazy" />
                </picture>
              ) : (
                <Image src={variant.src} alt={variant.alt} loading="lazy" />
              )}
            </a>
            <p>{variant.label}</p>
            {(variant.downloadHref || variant.sourceHref) && (
              <nav class="ptah-product-preview__variant-actions" aria-label={`${variant.label} actions`}>
                {variant.downloadHref && <a href={variant.downloadHref} download>Download</a>}
                {variant.sourceHref && <a href={variant.sourceHref}>Source</a>}
              </nav>
            )}
          </article>
        ))}
      </div>
    )}
  </figcaption>
</figure>

<script>
  // Full-size previews and downloads follow the site's explicit theme too.
  function syncDiagramLinks() {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLElement>('[data-site-themed]').forEach((figure) => {
      const href = dark ? figure.dataset.darkSrc : figure.dataset.lightSrc;
      if (!href) return;
      const image = figure.querySelector<HTMLImageElement>('[data-themed-diagram]');
      if (image) image.src = href;
      figure.querySelectorAll<HTMLAnchorElement>('a[data-preview-action]').forEach((link) => {
        if (link.dataset.previewAction !== 'source') link.href = href;
      });
    });
  }
  syncDiagramLinks();
  new MutationObserver(syncDiagramLinks).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  document.addEventListener('astro:page-load', syncDiagramLinks);
</script>

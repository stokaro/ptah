---
/**
 * The FAQ's filter: the tags every question carries, and one field over the
 * same questions.
 *
 * A tag is state, not text. Clicking one selects it, clicking a second widens
 * the result to questions in either, and the chips under a question say which
 * tags it carries and select from there. src/faq-tags.mjs is the one map: the
 * rail, the chips and the filter all read it, so no tag is written twice.
 *
 * The field is the other way in, for a reader who has words rather than a
 * facet. Free text matches what a question and its answer say, and a phrase
 * from src/faq-symptoms.mjs takes a curated route instead -- "drift ignored"
 * has to reach the question that says "drift disappeared", which no substring
 * match finds. A term and a tag selection narrow together.
 *
 * The page itself carries the structure -- `## Group` with `### Question`
 * under it -- so this adds no headings and moves nothing. It hides what does
 * not match, including a group heading whose questions all went and that
 * group's entry in the contents rail, and says how many of how many are left.
 *
 * Without JavaScript the rail renders and every question is on the page, which
 * is the right fallback for a page that is meant to be read.
 */
import { questionTags, tagLabels } from '../faq-tags.mjs';
import { faqSymptoms } from '../faq-symptoms.mjs';

interface Props {
  count: number;
}

const { count } = Astro.props;

const counts = new Map<string, number>();
for (const tags of Object.values(questionTags)) {
  for (const tag of tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}

// Most-used first, then alphabetical, so the rail opens with the facets that
// carry the page rather than with whatever sorted first.
const rail = [...counts.entries()]
  .map(([id, n]) => ({ id, n, label: tagLabels[id] ?? id }))
  .sort((left, right) => right.n - left.n || left.label.localeCompare(right.label));

// The rail is a row, not a list to read: the long tail sits behind one control
// so the questions stay on the first screen, on a phone too.
const LEAD = 12;
const lead = rail.slice(0, LEAD);
const rest = rail.slice(LEAD);
---

<ptah-faq-filter
  class="faq-filter"
  data-count={String(count)}
  data-tags={JSON.stringify(questionTags)}
  data-labels={JSON.stringify(tagLabels)}
  data-symptoms={JSON.stringify(
    Object.fromEntries(faqSymptoms.map((symptom) => [symptom.label.toLowerCase(), symptom.questions])),
  )}
>
  <label class="faq-filter__field">
    <span class="faq-filter__icon" aria-hidden="true">⌕</span>
    <input
      id="faq-filter-input"
      type="search"
      autocomplete="off"
      placeholder="Filter questions by words or symptoms"
      aria-label="Filter questions by words or symptoms"
    />
    <span class="faq-filter__count" data-faq-count>{count} questions</span>
    <button class="faq-filter__clear" type="button" data-faq-clear hidden>Clear ×</button>
  </label>

  <div
    class="faq-tags"
    role="group"
    aria-label="Filter by tag. Selecting more than one shows questions in any of them."
  >
    <span class="faq-tags__label">Tags</span>
    {
      lead.map((tag) => (
        <button class="faq-tag" type="button" data-faq-tag={tag.id} aria-pressed="false">
          {tag.label}
          <span class="faq-tag__n">{tag.n}</span>
        </button>
      ))
    }
    {
      rest.map((tag) => (
        <button
          class="faq-tag faq-tag--rest"
          type="button"
          data-faq-tag={tag.id}
          aria-pressed="false"
          hidden
        >
          {tag.label}
          <span class="faq-tag__n">{tag.n}</span>
        </button>
      ))
    }
    {
      rest.length > 0 && (
        <button class="faq-tags__more" type="button" data-faq-more aria-expanded="false">
          {rest.length} more
        </button>
      )
    }
  </div>

  <p class="faq-filter__empty" data-faq-empty hidden></p>
</ptah-faq-filter>

<script>
  class PtahFaqFilter extends HTMLElement {
    connectedCallback() {
      const content = document.querySelector('.sl-markdown-content');
      if (!content) return;

      const tagsByAnchor = JSON.parse(this.dataset.tags || '{}');
      const labels = JSON.parse(this.dataset.labels || '{}');
      const bySymptom = new Map(
        Object.entries(JSON.parse(this.dataset.symptoms || '{}')).map(([label, anchors]) => [
          label,
          new Set(anchors),
        ]),
      );

      // Starlight wraps a heading in a display:contents div, so the element
      // among the content's children is that wrapper. Walking from the heading
      // itself finds its own anchor link and stops, which would leave every
      // answer outside the question it belongs to.
      const top = (heading) => heading.closest('.sl-heading-wrapper') ?? heading;
      const headingIn = (node) => node.querySelector?.('h2[id], h3[id]') ?? null;

      const runFrom = (startEl, stop) => {
        const nodes = [startEl];
        for (let n = startEl.nextElementSibling; n; n = n.nextElementSibling) {
          const h = headingIn(n) ?? (/^H[23]$/.test(n.tagName) ? n : null);
          if (h && stop(h)) break;
          nodes.push(n);
        }
        return nodes;
      };

      const questions = [...content.querySelectorAll('h3[id]')].map((h) => ({
        id: h.id,
        tags: tagsByAnchor[h.id] ?? [],
        nodes: runFrom(top(h), () => true),
        // The question, its answer and the labels of the tags it carries,
        // lowercased once rather than per keystroke. The labels are in the
        // haystack because the rail puts those words right above the field: a
        // word a reader can see, typed into the field under it, has to reach
        // the questions it names.
        haystack: '',
      }));
      if (questions.length === 0) return;

      for (const q of questions) {
        q.haystack = [
          ...q.nodes.map((n) => n.textContent),
          ...q.tags.map((tag) => labels[tag] ?? tag),
        ]
          .join(' ')
          .toLowerCase();
      }

      // The chips go at the end of the answer, and are recorded with the
      // question: a chip appended after the run is gathered belongs to no
      // question and would stay on screen when its question is filtered away.
      for (const q of questions) {
        if (q.tags.length === 0) continue;
        const chips = this.#chips(q.tags, labels);
        q.nodes[q.nodes.length - 1].after(chips);
        q.nodes.push(chips);
      }

      const groups = [...content.querySelectorAll('h2[id]')].map((h) => ({
        id: h.id,
        nodes: runFrom(top(h), (next) => next.tagName === 'H2'),
      }));
      // A group owns the questions inside its run.
      for (const group of groups) {
        const own = new Set(group.nodes);
        group.questions = questions.filter((q) => own.has(q.nodes[0]));
        // The heading and anything before the first question: the intro line.
        const firstQuestion = group.questions[0]?.nodes[0];
        group.chrome = firstQuestion
          ? group.nodes.slice(0, group.nodes.indexOf(firstQuestion))
          : group.nodes;
      }

      // Whether the filter is hiding the anchor a link names. A question's run
      // and a group's chrome each carry the flag, so this reads back exactly
      // what render() wrote rather than inferring it from the document.
      const filteredAway = (id) =>
        questions.find((q) => q.id === id)?.nodes[0].hidden ??
        groups.find((group) => group.id === id)?.chrome[0]?.hidden ??
        false;

      // The contents rail lists the groups, so it follows the filter: a rail
      // still offering a group the page has hidden sends the reader nowhere.
      const railEntries = new Map();
      for (const link of document.querySelectorAll('starlight-toc a[href^="#"]')) {
        railEntries.set(decodeURIComponent(link.getAttribute('href').slice(1)), link);
      }

      const field = this.querySelector('#faq-filter-input');
      const countEl = this.querySelector('[data-faq-count]');
      const clearEl = this.querySelector('[data-faq-clear]');
      const emptyEl = this.querySelector('[data-faq-empty]');
      const moreEl = this.querySelector('[data-faq-more]');
      const railTags = [...this.querySelectorAll('[data-faq-tag]')];
      const total = Number(this.dataset.count) || questions.length;
      const active = new Set();

      // What an empty result says, which depends on what the reader did. A term
      // that found nothing under a tag may well be somewhere else on the page,
      // and the way out is the tag; a term that found nothing with no tag
      // picked has already searched the whole page, so naming tags there sends
      // the reader after a selection they never made.
      const emptyText = (typed, tagged) => {
        if (typed === '') return 'No question carries those tags.';
        return tagged
          ? `No question matches "${typed}" in the tags you picked. Clear the tags to search the whole page, or try the site search.`
          : `No question matches "${typed}". Try the site search, or open Troubleshooting.`;
      };

      const render = () => {
        const term = field.value.trim().toLowerCase();
        const routed = bySymptom.get(term);
        // Any selected tag matches, so a second facet widens the result rather
        // than narrowing it to the overlap. The term narrows what is left.
        const matches = (q) =>
          (active.size === 0 || q.tags.some((tag) => active.has(tag))) &&
          (term === '' ? true : routed ? routed.has(q.id) : q.haystack.includes(term));

        const shown = questions.filter(matches);
        const visible = new Set(shown.map((q) => q.id));

        for (const q of questions) {
          const hide = !visible.has(q.id);
          for (const node of q.nodes) node.hidden = hide;
        }
        for (const group of groups) {
          const hide = group.questions.every((q) => !visible.has(q.id));
          for (const node of group.chrome) node.hidden = hide;
          const entry = railEntries.get(group.id);
          // Hide the row, not the link: the rail nests its links in list
          // items, and hiding the anchor alone leaves an empty bullet.
          if (entry) (entry.closest('li') ?? entry).hidden = hide;
        }
        for (const button of railTags) {
          button.setAttribute('aria-pressed', String(active.has(button.dataset.faqTag)));
        }
        for (const chip of content.querySelectorAll('[data-faq-chip]')) {
          chip.setAttribute('aria-pressed', String(active.has(chip.dataset.faqChip)));
        }

        const filtered = active.size > 0 || term !== '';
        countEl.textContent = filtered ? `${shown.length} of ${total}` : `${total} questions`;
        clearEl.hidden = !filtered;
        emptyEl.hidden = shown.length > 0;
        if (shown.length === 0) emptyEl.textContent = emptyText(field.value.trim(), active.size > 0);
      };

      const toggle = (tag) => {
        if (active.has(tag)) active.delete(tag);
        else active.add(tag);
        // A tag picked from the long tail stays visible once it is selected.
        if (active.has(tag)) this.#reveal(tag);
        render();
      };

      field.addEventListener('input', render);
      for (const button of railTags) {
        button.addEventListener('click', () => toggle(button.dataset.faqTag));
      }
      content.addEventListener('click', (event) => {
        const chip = event.target.closest('[data-faq-chip]');
        if (chip) {
          toggle(chip.dataset.faqChip);
          this.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
      });
      clearEl.addEventListener('click', () => {
        active.clear();
        field.value = '';
        render();
        field.focus();
      });
      moreEl?.addEventListener('click', () => {
        const expanded = moreEl.getAttribute('aria-expanded') === 'true';
        moreEl.setAttribute('aria-expanded', String(!expanded));
        for (const button of this.querySelectorAll('.faq-tag--rest')) {
          // A selected tag survives the fold. Folding away the only control
          // that releases it leaves the page filtered by a facet nothing on
          // screen explains, and the way out left is Clear, which also drops
          // the other tags and the typed term.
          button.hidden = expanded && !active.has(button.dataset.faqTag);
        }
      });

      // A shared link names one question, and a filter that hid it would make
      // the link look broken, so arriving at a hidden anchor clears the filter
      // and keeps every anchor reachable. An anchor the filter is still showing
      // is navigation inside the result -- the contents rail offers those and
      // nothing else -- and the filter survives it.
      const revealHash = () => {
        const id = decodeURIComponent(location.hash.replace(/^#/, ''));
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        if (filteredAway(id)) {
          active.clear();
          field.value = '';
          render();
        }
        target.scrollIntoView({ block: 'start' });
      };
      window.addEventListener('hashchange', revealHash);

      render();
      revealHash();
    }

    #chips(tags, labels) {
      const list = document.createElement('p');
      list.className = 'faq-chips';
      for (const tag of tags) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'faq-chip';
        chip.dataset.faqChip = tag;
        chip.setAttribute('aria-pressed', 'false');
        chip.textContent = labels[tag] ?? tag;
        list.append(chip);
      }
      return list;
    }

    #reveal(tag) {
      const button = this.querySelector(`.faq-tag--rest[data-faq-tag="${tag}"]`);
      if (button) button.hidden = false;
    }
  }

  if (!customElements.get('ptah-faq-filter')) {
    customElements.define('ptah-faq-filter', PtahFaqFilter);
  }
</script>

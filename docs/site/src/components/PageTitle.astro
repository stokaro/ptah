---
/**
 * The heading block: the breadcrumb row with the page-type badge, the title,
 * and the description as a lede. The concept puts no actions above the title;
 * the split button lives above the contents rail (TableOfContents.astro) and
 * the source links in the footer (Footer.astro), with the "Evidence verified"
 * fact.
 *
 * One exception, for the documentation of released versions. The release
 * overlay (scripts/apply-release-ui-overlay.mjs) copies this file, PageActions
 * and the two lib modules into the checkout of a released tag, whose own
 * astro.config.mjs registers neither the contents-rail nor the footer
 * override. There the heading carries the page actions itself, with the
 * source links beside them, as it did before the redesign. The signal is the
 * site configuration: when TableOfContents is overridden, the rail has them.
 *
 * The styles are scoped here for the same reason: a release checkout has its
 * own stylesheets, so the heading has to bring its look along, and every token
 * it reads falls back to a Starlight variable. The lede's type is content.css's
 * on this site (.ptah-lede); a release renders it as a plain paragraph.
 */
import config from 'virtual:starlight/user-config';
import { getCollection } from 'astro:content';
import PageActions from './PageActions.astro';
import { breadcrumbTrail, sidebarOverviewHrefs } from '../lib/page-context.mjs';
import { pageSourceActions, pageTypeBadge, publishesLlmsTxt } from '../lib/page-furniture.mjs';

// Starlight's table of contents targets this id for the page title. Its
// constants module is internal and is intentionally not part of package
// exports, so the override keeps the public component contract explicitly.
const PAGE_TITLE_ID = '_top';
const { entry, sidebar, siteTitleHref } = Astro.locals.starlightRoute;
const landingEntries = await getCollection('docs', ({ data }) => data.type === 'landing');
const landingHrefs = new Set([
  ...landingEntries.map(({ id }) => `${siteTitleHref}${id ? `${id}/` : ''}`),
  ...sidebarOverviewHrefs(sidebar),
]);
const breadcrumbs = breadcrumbTrail(sidebar, landingHrefs);
const ancestors = breadcrumbs.filter((crumb) => !crumb.current);
const badge = pageTypeBadge(entry);
const searchAliases = entry.data.searchAliases ?? [];
const description = entry.data.description?.trim();
/* A description may quote a command or a file in backticks (Markdown's inline
 * code); the lede renders those as inline code, the way the concept draws
 * `ptah schema export` in its lede. The frontmatter value itself stays as it
 * is for the description meta tag. */
const ledeParts = description ? description.split(/`([^`]+)`/) : [];
// Starlight fills every component slot with its own path, so "overridden"
// means "not Starlight's": on this site the slot names src/components/
// TableOfContents.astro, in a release checkout it still names Starlight's.
const actionsInRail = !String(config.components?.TableOfContents ?? '').startsWith('@astrojs/starlight/');
const source = actionsInRail
  ? { hasSource: false }
  : pageSourceActions(entry, { pageUrl: Astro.url.href, baseUrl: import.meta.env.BASE_URL });
---

<div class="page-heading">
  {(ancestors.length > 0 || badge || source.hasSource) && (
    <div class="ptah-page-context">
      {ancestors.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {
              /*
               * Stands in for the ancestors a phone does not show: below 40rem
               * only the nearest one stays visible, after this marker. It is
               * `aria-hidden` because the ancestors themselves stay in the
               * accessibility tree at that width; the marker only records
               * that something was folded.
               */
              ancestors.length > 1 && (
                <li class="collapsed-item" aria-hidden="true">
                  <span class="collapsed-crumb">…</span>
                </li>
              )
            }
            {
              breadcrumbs.map((crumb, index) => (
                <li class:list={{ 'group-item': !crumb.current, 'current-item': crumb.current }}>
                  {index > 0 && (
                    <span class="ptah-crumb-separator" aria-hidden="true">
                      /
                    </span>
                  )}
                  {crumb.current ? (
                    <span class="current-crumb" aria-current="page">{crumb.label}</span>
                  ) : crumb.href ? (
                    <a class="group-crumb" href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span class="group-crumb">{crumb.label}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
      )}
      {badge && (
        <span class="ptah-page-type">
          <span class="sr-only">Page type: </span>{badge}
        </span>
      )}
      {source.hasSource && (
        <div class="ptah-heading-actions">
          <PageActions
            markdownUrl={source.markdownUrl}
            markdownLabel={source.markdownLabel}
            actions={source.actions}
            sourceContext={source.sourceContext}
            llmsEntry={publishesLlmsTxt}
            sourceLinks
          />
        </div>
      )}
    </div>
  )}

  <h1
    id={PAGE_TITLE_ID}
    data-search-aliases={searchAliases.length > 0 ? searchAliases.join(' · ') : undefined}
    data-pagefind-meta={searchAliases.length > 0 ? 'searchAliases[data-search-aliases]' : undefined}
  >{entry.data.title}</h1>
  {description && (
    <p class="ptah-lede">{ledeParts.map((part, index) => (index % 2 ? <code>{part}</code> : part))}</p>
  )}
</div>

<script>
  /**
   * Starlight and Expressive Code make wide tables and code blocks scroll
   * horizontally, but a keyboard user cannot reach an unnamed scroll region
   * unless it participates in the tab order. Only regions that actually
   * overflow receive a tab stop; resizing removes stops that are no longer
   * useful.
   */
  function updateScrollableRegions() {
    const selector = [
      '.sl-markdown-content pre',
      '.sl-markdown-content table',
      '.sl-markdown-content .ptah-wide-table',
    ].join(',');

    for (const region of document.querySelectorAll<HTMLElement>(selector)) {
      const scrolls = region.scrollWidth > region.clientWidth || region.scrollHeight > region.clientHeight;
      if (scrolls) {
        region.tabIndex = 0;
        region.dataset.ptahScrollable = 'true';
      } else if (region.dataset.ptahScrollable === 'true') {
        region.removeAttribute('tabindex');
        delete region.dataset.ptahScrollable;
      }
    }
  }

  function initializeReferenceFilters() {
    for (const filter of document.querySelectorAll<HTMLElement>('.ptah-reference-filter')) {
      const input = filter.querySelector<HTMLInputElement>('input[type="search"]');
      const status = filter.querySelector<HTMLElement>('[data-ptah-filter-status]');
      if (!input || !status || input.dataset.ptahFilterReady === 'true') continue;
      input.dataset.ptahFilterReady = 'true';

      const content = filter.closest<HTMLElement>('.sl-markdown-content');
      if (!content) continue;
      const mode = filter.dataset.mode ?? 'next-table';
      const following = [...content.querySelectorAll<HTMLTableElement>('table')].filter((table) =>
        Boolean(filter.compareDocumentPosition(table) & Node.DOCUMENT_POSITION_FOLLOWING),
      );
      const tables = mode === 'all-tables' ? following : following.slice(0, 1);
      const rows = tables.flatMap((table) => [...table.querySelectorAll<HTMLTableRowElement>('tbody tr')]);

      const apply = () => {
        const query = input.value.trim().toLocaleLowerCase();
        let visible = 0;
        for (const row of rows) {
          const matches = query === '' || (row.textContent ?? '').toLocaleLowerCase().includes(query);
          row.hidden = !matches;
          if (matches) visible++;
        }
        for (const table of tables) {
          const tableVisible = [...table.querySelectorAll('tbody tr')].some((row) => !row.hidden);
          table.hidden = !tableVisible;
          const label = table.previousElementSibling;
          if (mode === 'all-tables' && label?.matches('p:has(> strong:only-child)')) {
            (label as HTMLElement).hidden = !tableVisible;
          }
        }
        status.textContent = query === ''
          ? `${rows.length} entries`
          : `${visible} of ${rows.length} entries`;
      };

      input.addEventListener('input', apply);
      apply();
    }
  }

  requestAnimationFrame(updateScrollableRegions);
  requestAnimationFrame(initializeReferenceFilters);
  addEventListener('resize', updateScrollableRegions, { passive: true });
</script>

<style>
  /* Breadcrumb row, title, lede: 14px apart, as the concept stacks them. The
   * lede's type is content.css's (.ptah-lede); only the spacing is decided
   * here, so the lede carries no margin of its own. */
  .page-heading {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .page-heading > .ptah-lede {
    margin: 0;
  }

  /* 13px sans in gray-3: orientation, not a control. The badge sits on the
   * same line as the trail and wraps under it when the trail is long. */
  .ptah-page-context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  /* A release checkout's page actions take the row's right end. */
  .ptah-heading-actions {
    margin-inline-start: auto;
  }

  .breadcrumbs {
    min-width: 0;
  }
  .breadcrumbs ol,
  .breadcrumbs li {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The trail wraps whole crumbs rather than truncating any of them (measured
   * in an earlier pass: a 13rem ceiling and shrinking items cut 133 of 816
   * crumbs across eight widths; wrapping cut none). A crumb alone on a line
   * too narrow for it breaks inside its own text instead of losing characters. */
  .breadcrumbs ol {
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .breadcrumbs li {
    gap: 8px;
  }
  .group-crumb,
  .current-crumb {
    overflow-wrap: anywhere;
  }
  .ptah-crumb-separator {
    color: var(--sl-color-gray-3);
  }
  a.group-crumb {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  a.group-crumb:hover {
    color: var(--sl-color-text-accent);
  }
  /* The current page stays in the list for its `aria-current`, but the title
   * right below says the same thing to a sighted reader; the concept's trail
   * ends at the parent group. */
  .breadcrumbs .current-item {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .breadcrumbs .collapsed-item {
    display: none;
  }

  /* The page-type badge: mono uppercase in a hairline box, gray-2 so the 11px
   * text keeps 4.5:1 with room (gray-3 would pass at 4.97 dark / 5.05 light,
   * but small capitals read best a step stronger, and the concept draws the
   * badge in its secondary text color). */
  .ptah-page-type {
    padding: 1px 7px;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono, var(--__sl-font-mono));
    font-size: 0.6875rem; /* 11px */
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* The title: 500 at the token size (34px; tokens.css narrows it on phones),
   * tight tracking, balanced lines. */
  .page-heading h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-h1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  /* On a phone the trail folds to "… / <nearest group>": the deepest trail
   * this sidebar produces takes three lines in the row a 375px window leaves,
   * and the nearest group is the one the reader came through. The folded
   * groups stay in the accessibility tree (hidden the accessible way, not with
   * display: none); the marker records that they were folded. The row is
   * 12.5px and the badge 10.5px, as the concept draws them at 390. */
  @media (max-width: 40rem) {
    .ptah-page-context {
      font-size: 0.78125rem;
    }
    .breadcrumbs .group-item:not(:nth-last-child(2)) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* A folded crumb is still a link in the tab order; while it has focus it
     * takes its place in the row again, so the focus ring and the text are
     * there to see (the skip-link technique), and the marker steps aside. */
    .breadcrumbs .group-item:not(:nth-last-child(2)):focus-within {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
    .breadcrumbs .collapsed-item {
      display: flex;
    }
    .breadcrumbs ol:has(.group-item:focus-within) .collapsed-item {
      display: none;
    }
    .ptah-page-type {
      padding: 1px 6px;
      font-size: 0.65625rem;
    }
  }
</style>

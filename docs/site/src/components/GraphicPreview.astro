---
// One viewer per article. Footer also carries it into maintained release builds.
---

<ptah-graphic-preview data-pagefind-ignore>
  <dialog aria-labelledby="ptah-graphic-preview-title" aria-describedby="ptah-graphic-preview-caption">
    <header class="graphic-preview-header">
      <h2 id="ptah-graphic-preview-title">Graphic preview</h2>
      <button type="button" data-preview-control="close" autofocus>Close <span aria-hidden="true">×</span></button>
    </header>
    <div class="graphic-preview-controls" data-preview-controls role="group" aria-label="Image magnification">
      <button type="button" data-preview-control="fit">Fit image</button>
      <button type="button" data-preview-control="width">Fit width</button>
      <button type="button" data-preview-control="actual">100%</button>
      <div class="graphic-preview-zoom">
        <button type="button" data-preview-control="out" aria-label="Zoom out">−</button>
        <output data-preview-scale aria-label="Current magnification">100%</output>
        <button type="button" data-preview-control="in" aria-label="Zoom in">+</button>
      </div>
    </div>
    <div class="graphic-preview-stage">
      <div class="graphic-preview-viewport" data-preview-viewport tabindex="0" role="region" aria-label="Image, scroll to inspect details">
        <div class="graphic-preview-canvas" data-preview-canvas>
          <img data-preview-image alt="" draggable="false" hidden />
        </div>
      </div>
      <iframe data-preview-document title="Generated output preview" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" hidden></iframe>
      <p class="graphic-preview-error" data-preview-error hidden>
        This preview could not be loaded. <a data-preview-original>Open the original file</a>.
      </p>
    </div>
    <div class="graphic-preview-footer">
      <p id="ptah-graphic-preview-caption" data-preview-caption></p>
      <p class="graphic-preview-help" data-preview-help>Scroll or drag to inspect details. Pinch or use + and − to zoom.</p>
      <p data-preview-status role="status"></p>
    </div>
  </dialog>
</ptah-graphic-preview>

<script>
  import '../lib/graphic-preview.mjs';
</script>

<style>
  ptah-graphic-preview { display: contents; }

  dialog {
    box-sizing: border-box;
    position: fixed;
    inset: 0;
    width: calc(100% - 2rem);
    height: calc(100dvh - 2rem);
    max-width: 90rem;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    background: var(--ptah-surface, var(--sl-color-bg));
    color: var(--sl-color-text);
    font-family: var(--sl-font);
    font-size: 0.875rem;
    line-height: 1.5;
    box-shadow: none;
  }

  dialog[open] {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
  }

  dialog[data-kind='document'] { grid-template-rows: auto minmax(0, 1fr) auto; }

  dialog::backdrop { background: var(--sl-color-backdrop-overlay); }
  dialog [hidden] { display: none !important; }

  .graphic-preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .graphic-preview-header h2 {
    margin: 0;
    border: 0;
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 2px;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  button:hover:not(:disabled), button[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }

  button:disabled { opacity: 0.5; cursor: default; }

  :is(button, a, .graphic-preview-viewport):focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .graphic-preview-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: 0.8125rem;
  }

  .graphic-preview-zoom {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-inline-start: auto;
  }

  .graphic-preview-zoom button { min-width: 2.25rem; font-size: 1.125rem; }
  output { min-width: 3.75rem; text-align: center; font-variant-numeric: tabular-nums; }

  .graphic-preview-stage {
    position: relative;
    display: grid;
    min-height: 0;
    min-width: 0;
    background: var(--sl-color-bg-inline-code);
  }

  .graphic-preview-viewport {
    min-height: 0;
    min-width: 0;
    overflow: auto;
    overscroll-behavior: contain;
    scroll-behavior: auto;
    touch-action: none;
    cursor: grab;
  }

  .graphic-preview-viewport[data-dragging] { cursor: grabbing; }
  .graphic-preview-viewport:focus-visible { outline-offset: -3px; }

  .graphic-preview-canvas {
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-width: 100%;
    min-height: 100%;
  }

  .graphic-preview-canvas img {
    display: block;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    user-select: none;
  }

  iframe { width: 100%; height: 100%; min-height: 0; border: 0; background: var(--sl-color-bg); }

  .graphic-preview-footer {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
  }

  .graphic-preview-footer p { margin: 0; }
  [data-preview-caption] { max-height: 3em; overflow: auto; }
  .graphic-preview-help, [data-preview-status] { color: var(--sl-color-gray-3); }
  [data-preview-status]:empty { display: none; }
  .graphic-preview-error { align-self: center; justify-self: center; margin: 1rem; }
  .graphic-preview-error a { color: var(--sl-color-text-accent); }

  :global(a[data-graphic-preview]) { cursor: zoom-in; }
  :global(.ptah-graphic-preview-trigger) { display: block; width: fit-content; max-width: 100%; margin-inline: auto; }

  @media (width < 50rem) {
    dialog { width: 100%; height: 100dvh; border-radius: 0; }
    button { min-height: 2.75rem; }
    .graphic-preview-controls { gap: 0.375rem; padding-inline: 0.625rem; }
    .graphic-preview-zoom button { min-width: 2.75rem; }
    .graphic-preview-zoom { margin-inline-start: 0; }
  }
</style>

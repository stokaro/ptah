---
/**
 * The mount point for the documentation version picker. The picker is
 * version-picker.js and version-picker.css, served once at the Pages root and
 * loaded from there by every documentation version, so a change to it reaches
 * every version on the next deploy. This component is the part a version
 * carries: it names the version the page belongs to and where the root is, and
 * shows that version as text until the script replaces it.
 *
 * The release UI overlay copies this file into every released version it
 * rebuilds (scripts/data/release-ui-overlay.json). Keep it to the mount point:
 * whatever else lands here is frozen into each release's build, which is the
 * coupling the root files exist to avoid.
 */
const base = import.meta.env.BASE_URL;
const segments = base.split('/').filter(Boolean);
const current = segments[segments.length - 1] || 'edge';
const versionSuffix = `${current}/`;
const root = base.endsWith(versionSuffix) ? base.slice(0, -versionSuffix.length) : base;

// The dev server serves public/ under the version's base rather than at the
// root, and it has no version index, so a local preview loads the picker from
// the base and reads the published list of versions. Nothing is imported for
// that: this file is built inside every overlaid release, and a module it
// names has to exist in the oldest of them.
const assets = import.meta.env.DEV ? base : root;
const versions = import.meta.env.DEV ? new URL('/versions.json', import.meta.env.SITE).href : `${root}versions.json`;
---

<div class="ptah-version-picker" data-ptah-version-picker data-current={current} data-root={root} data-versions={versions}>
  <span class="ptah-version-picker__current">{current}</span>
</div>
<link rel="stylesheet" href={`${assets}version-picker.css`} />
<script is:inline defer src={`${assets}version-picker.js`}></script>

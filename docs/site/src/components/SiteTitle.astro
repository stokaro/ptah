---
/**
 * The brand row of the header: the mark and "Ptah" link to the documentation
 * root, "Docs" names it beside them, and the version picker sits at the row's
 * end. It replaces Starlight's SiteTitle so the row reads the same as the
 * header of ptah.run (stokaro/ptah#2893).
 *
 * The mark is the control a reader reaches for to go home, so it goes to the
 * documentation root rather than to ptah.run. It pointed outward once, and
 * below 50rem the header hides both "Docs" and the links beside it, which left
 * a phone with no way back to the documentation and one link that looked like
 * the way back and was not (stokaro/ptah#2930). ptah.run stays a header link;
 * HeaderLinks.astro renders it first.
 *
 * The picker itself is served from the Pages root and shared by every version;
 * VersionPicker.astro is only its mount point.
 */
import logo from '../assets/logo.svg';
import VersionPicker from './VersionPicker.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="ptah-brand">
  <a class="ptah-brand__site" href={siteTitleHref} translate="no">
    <img src={logo.src} alt="" width="20" height="20" />
    Ptah
  </a>
  <a class="ptah-brand__docs" href={siteTitleHref}>Docs</a>
  <VersionPicker />
</div>

<style>
  /* The brand cell of the concept: mark 20px, "Ptah" 600 14.5px, "Docs" 400
   * 14.5px in gray-3, and the version pill at the cell's right edge. The row
   * fills the header's title-wrapper (header.css makes that wrapper the 16rem
   * cell) so the pill's auto margin reaches the cell's inner edge. */
  .ptah-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
  }

  .ptah-brand__site {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
    font-size: 0.90625rem;
    font-weight: 600;
    line-height: 1;
    /* Invisible in the centered cell; lifts the 15px line to a 25px target. */
    padding-block: 0.3125rem;
    text-decoration: none;
  }
  .ptah-brand__site:hover {
    color: var(--sl-color-white);
  }
  .ptah-brand__site img {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 5px;
    /* The mark is a dark square; on the dark page tokens.css gives the ring a
     * hairline color, on the light page it is transparent. */
    outline: 1px solid var(--ptah-logo-ring, transparent);
  }

  .ptah-brand__docs {
    color: var(--sl-color-gray-3);
    font-size: 0.90625rem;
    font-weight: 400;
    line-height: 1;
    padding-block: 0.3125rem;
    text-decoration: none;
  }
  .ptah-brand__docs:hover {
    color: var(--sl-color-text-accent);
  }

  /* Phone: the mark and "Ptah"; no "Docs", the header has three 44px controls
   * to fit at the right. */
  @media (width < 50rem) {
    .ptah-brand__docs {
      display: none;
    }
  }

</style>

---
interface Props {
  markdownUrl: string;
}

const { markdownUrl } = Astro.props;
---

<ptah-page-actions data-markdown-url={markdownUrl}>
  <div class="page-actions-control">
    <button
      class="copy-page-button"
      type="button"
      data-copy-page
      aria-label="Copy page as Markdown"
      disabled
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="7" y="5" width="11" height="15" rx="2"></rect>
        <path d="M9 5V3.75C9 2.78 9.78 2 10.75 2h3.5C15.22 2 16 2.78 16 3.75V5"></path>
      </svg>
      <span data-copy-label>Copy page</span>
    </button>

    <details>
      <summary aria-label="More page actions">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m8 10 4 4 4-4"></path>
        </svg>
      </summary>

      <div class="page-actions-menu">
        <button type="button" class="page-action" data-copy-page disabled>
          <span class="page-action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="7" y="5" width="11" height="15" rx="2"></rect>
              <path d="M9 5V3.75C9 2.78 9.78 2 10.75 2h3.5C15.22 2 16 2.78 16 3.75V5"></path>
            </svg>
          </span>
          <span>
            <strong>Copy as Markdown</strong>
            <small>Use the page in an editor or assistant</small>
          </span>
        </button>

        <a
          class="page-action"
          href="https://chatgpt.com/"
          target="_blank"
          rel="noreferrer"
          data-copy-for="ChatGPT"
          aria-disabled="true"
          tabindex="-1"
        >
          <span class="page-action-icon assistant-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 3.5a4.2 4.2 0 0 1 4.1 3.25 4.2 4.2 0 0 1 1.15 8.02A4.2 4.2 0 0 1 10.1 18.3a4.2 4.2 0 0 1-6.2-4.15A4.2 4.2 0 0 1 6.85 6.4 4.2 4.2 0 0 1 12 3.5Z"></path>
              <path d="m8.2 10 3.8-2.2 3.8 2.2v4.4L12 16.6l-3.8-2.2Z"></path>
            </svg>
          </span>
          <span>
            <strong>Open in ChatGPT</strong>
            <small>Copy the page, then open a new chat</small>
          </span>
          <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 5h5v5M19 5l-8 8"></path>
            <path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
          </svg>
        </a>

        <a
          class="page-action"
          href="https://claude.ai/new"
          target="_blank"
          rel="noreferrer"
          data-copy-for="Claude"
          aria-disabled="true"
          tabindex="-1"
        >
          <span class="page-action-icon assistant-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"></path>
            </svg>
          </span>
          <span>
            <strong>Open in Claude</strong>
            <small>Copy the page, then open a new chat</small>
          </span>
          <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 5h5v5M19 5l-8 8"></path>
            <path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
          </svg>
        </a>
      </div>
    </details>
  </div>

  <span class="copy-status" role="status" aria-live="polite"></span>
</ptah-page-actions>

<style>
  ptah-page-actions {
    position: relative;
    display: block;
    flex: none;
  }

  .page-actions-control {
    display: flex;
    min-height: 2.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-black);
    box-shadow: var(--sl-shadow-sm);
  }

  .copy-page-button,
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-1);
    background: transparent;
    cursor: pointer;
  }

  .copy-page-button {
    gap: 0.45rem;
    border: 0;
    padding: 0.45rem 0.75rem;
    border-radius: 0.55rem 0 0 0.55rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }

  .copy-page-button svg,
  summary svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  details {
    position: relative;
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  summary {
    width: 2.4rem;
    height: 100%;
    border-radius: 0 0.55rem 0.55rem 0;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .copy-page-button:hover,
  summary:hover,
  details[open] summary {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .copy-page-button:focus-visible,
  summary:focus-visible,
  .page-action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .page-actions-menu {
    position: absolute;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    width: min(21rem, calc(100vw - 2rem));
    padding: 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    box-shadow: var(--sl-shadow-lg);
  }

  .page-action {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.7rem;
    border: 0;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-1);
    background: transparent;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .page-action:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .copy-page-button:disabled,
  .page-action:disabled,
  .page-action[aria-disabled='true'],
  .page-action[aria-disabled='true']:hover {
    color: var(--sl-color-gray-3);
    background: transparent;
    cursor: wait;
  }

  .page-action-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }

  .page-action-icon svg,
  .external-icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .assistant-icon svg {
    stroke-width: 1.5;
  }

  .page-action strong,
  .page-action small {
    display: block;
  }

  .page-action strong {
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }

  .page-action small {
    margin-top: 0.1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }

  .external-icon {
    color: var(--sl-color-gray-3);
  }

  .copy-status {
    position: absolute;
    inset-block-start: calc(100% + 0.35rem);
    inset-inline-end: 0;
    width: max-content;
    max-width: 16rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }

  @media (max-width: 30rem) {
    .copy-page-button {
      padding-inline: 0.6rem;
    }

    .copy-page-button span {
      display: none;
    }
  }
</style>

<script>
  class PtahPageActions extends HTMLElement {
    private statusTimer?: number;
    private markdown = '';
    private loading?: Promise<string>;

    connectedCallback() {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';

      const details = this.querySelector<HTMLDetailsElement>('details');
      const status = this.querySelector<HTMLElement>('.copy-status');

      const announce = (message: string) => {
        if (!status) return;
        status.textContent = message;
        window.clearTimeout(this.statusTimer);
        this.statusTimer = window.setTimeout(() => {
          status.textContent = '';
        }, 3000);
      };

      const fallbackCopy = () => {
        const textarea = document.createElement('textarea');
        textarea.value = this.markdown;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        if (!copied) throw new Error('copy command failed');
      };

      const copy = async (destination?: string) => {
        try {
          const markdown = await this.loadMarkdown();
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(markdown);
          } else {
            fallbackCopy();
          }
          announce(destination ? `Page copied — paste it into ${destination}.` : 'Page copied as Markdown.');
        } catch {
          announce('Copy failed. Select the page text instead.');
        }
      };

      void this.loadMarkdown().then(() => {
        this.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((button) => {
          button.disabled = false;
        });
        this.querySelectorAll<HTMLAnchorElement>('[data-copy-for]').forEach((link) => {
          link.removeAttribute('aria-disabled');
          link.removeAttribute('tabindex');
        });
      }).catch(() => {
        announce('The Markdown source could not be loaded.');
      });

      this.querySelectorAll<HTMLElement>('[data-copy-page]').forEach((button) => {
        button.addEventListener('click', () => {
          void copy();
          details?.removeAttribute('open');
        });
      });

      this.querySelectorAll<HTMLAnchorElement>('[data-copy-for]').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (link.getAttribute('aria-disabled') === 'true') {
            event.preventDefault();
            return;
          }
          void copy(link.dataset.copyFor);
          details?.removeAttribute('open');
        });
      });

      document.addEventListener('click', (event) => {
        if (details?.open && event.target instanceof Node && !this.contains(event.target)) {
          details.removeAttribute('open');
        }
      });

      this.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details?.open) return;
        details.removeAttribute('open');
        details.querySelector<HTMLElement>('summary')?.focus();
      });
    }

    private loadMarkdown(): Promise<string> {
      if (this.markdown) return Promise.resolve(this.markdown);
      if (this.loading) return this.loading;

      const url = this.dataset.markdownUrl;
      if (!url) return Promise.reject(new Error('missing Markdown URL'));

      this.loading = fetch(url, { headers: { Accept: 'text/markdown' } })
        .then((response) => {
          if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
          return response.text();
        })
        .then((markdown) => {
          this.markdown = markdown;
          return markdown;
        });
      return this.loading;
    }
  }

  if (!customElements.get('ptah-page-actions')) {
    customElements.define('ptah-page-actions', PtahPageActions);
  }
</script>

---
/**
 * A grid of linked cards, each a screenshot of product output with a title
 * and one line on what it is; the landing page's "See what Ptah produces".
 * Cards follow the ProductPreview figure's vocabulary (stokaro/ptah#2893,
 * concept 1a): a hairline frame on the raised surface, the image on the code
 * surface, a 500 15px title. The styles are in src/styles/ptah/figures.css.
 */
import { Image } from 'astro:assets';

interface GalleryItem {
  title: string;
  description: string;
  href: string;
  src: ImageMetadata;
  darkSrc?: ImageMetadata;
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="ptah-output-gallery">
  {items.map((item) => (
    <a class="ptah-output-gallery__item" href={item.href}>
      <figure>
        {item.darkSrc ? (
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={item.darkSrc.src} />
            <Image src={item.src} alt={item.alt} loading="lazy" />
          </picture>
        ) : (
          <Image src={item.src} alt={item.alt} loading="lazy" />
        )}
        <figcaption>
          <strong>{item.title}</strong>
          <span>{item.description}</span>
        </figcaption>
      </figure>
    </a>
  ))}
</div>

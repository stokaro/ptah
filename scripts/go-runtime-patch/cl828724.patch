+// TestExceptionStackReserve checks that the per-stack OS reserve covers the
+// CONTEXT the kernel pushes when it dispatches an exception on a goroutine
+// stack, and that the stack guard and minimum stack allocation moved with it.
+// See issue 81238.
+func TestExceptionStackReserve(t *testing.T) {
+	kernel32, err := syscall.LoadDLL("kernel32.dll")
+	if err != nil {
+		t.Fatal(err)
+	}
+	initializeContext, err := kernel32.FindProc("InitializeContext")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Ask the kernel the same question osinit asked, with the same errno
+	// handling (see exceptionStackReserve).
+	contextSize := func(flags uintptr) (n uint32, errno syscall.Errno) {
+		_, _, e := initializeContext.Call(0, flags, 0, uintptr(unsafe.Pointer(&n)))
+		if errno = e.(syscall.Errno); errno != runtime.ErrorInsufficientBuffer {
+			return 0, errno
+		}
+		return n, 0
+	}
+	flags := uintptr(runtime.ContextAllXState)
+	n, errno := contextSize(flags)
+	switch {
+	case errno == 0:
+	case errno == runtime.ErrorNotSupported,
+		errno == runtime.ErrorInvalidParameter && runtime.GOARCH == "arm64":
+		flags = runtime.ContextAll
+		n, errno = contextSize(flags)
+	}
+	if errno != 0 {
+		t.Fatalf("InitializeContext(%#x): %v", flags, errno)
+	}
+	exceptionRecord := uintptr(152) // EXCEPTION_RECORD on amd64 and arm64
+	if runtime.GOARCH == "386" {
+		exceptionRecord = 80
+	}
+	reserve := runtime.StackSystemReserve()
+	t.Logf("InitializeContext(%#x) = %d bytes; reserve = %d, guard = %d, minimum stack = %d",
+		flags, n, reserve, runtime.StackGuardSize(), runtime.StackMinAlloc())
+	if reserve < uintptr(n)+exceptionRecord {
+		t.Errorf("stack reserve %d cannot hold a %d-byte CONTEXT plus a %d-byte EXCEPTION_RECORD", reserve, n, exceptionRecord)
+	}
+	if runtime.StackGuardSize() < reserve {
+		t.Errorf("stack guard %d is below the reserve %d", runtime.StackGuardSize(), reserve)
+	}
+	if min := runtime.StackMinAlloc(); min <= runtime.StackGuardSize() {
+		t.Errorf("minimum stack %d leaves no room above the guard %d", min, runtime.StackGuardSize())
+	}
+}
+
+// TestExceptionAfterStackGrowShrink exercises a real, recovered hardware
+// fault on a goroutine whose stack grew deep and was then shrunk by the
+// garbage collector, on whatever OS exception reserve this host actually
+// has. The work runs in a re-executed copy of the test binary, because a
+// reserve that turns out to be too small crashes the process (see
+// signal_windows.go's dispatch-below-stack-bottom throw). See issue 81238.
+func TestExceptionAfterStackGrowShrink(t *testing.T) {
+	if os.Getenv("TEST_EXCEPTION_AFTER_STACK_GROW_SHRINK") != "1" {
+		runSelfInSubprocess(t, "TestExceptionAfterStackGrowShrink", "TEST_EXCEPTION_AFTER_STACK_GROW_SHRINK")
+		return
+	}
+	const deepTo = 80
+	const parkAt = 0 // grow, fully return, then park
+	var faulted bool
+	var sizes stackSizes
+	runParkedUnderGC(func(ready chan<- struct{}, resume <-chan struct{}) {
+		faulted = faultAfterParkPoint(0, deepTo, parkAt, [1024]byte{}, ready, resume, &sizes)
+	})
+	sizes.requireShrink(t)
+	if !faulted {
+		t.Fatal("probe did not fault")
+	}
+}
+
+// stackSizes records a goroutine's stack allocation before it parks and
+// right after it resumes, so a test can tell whether the GC actually
+// shrank the stack in between. Without that check, both subprocess tests
+// would pass vacuously if shrinking never happened.
+type stackSizes struct {
+	parked, resumed uintptr
+}
+
+func (s *stackSizes) requireShrink(t *testing.T) {
+	t.Helper()
+	t.Logf("stack %d bytes when parked, %d after resume", s.parked, s.resumed)
+	if s.resumed >= s.parked {
+		t.Fatalf("stack was not shrunk while parked (%d -> %d bytes); the test exercised nothing", s.parked, s.resumed)
+	}
+}
+
+// TestExceptionReserveSurvivesShrink is TestExceptionAfterStackGrowShrink's
+// counterpart that exercises the shrink-time accounting directly, so the
+// coverage does not depend on the builder's CPU having AMX or another large
+// XSTATE area: it forces an OS reserve, then checks that shrinkstack never
+// leaves less than that reserve below SP. It also runs in a re-executed
+// copy of the test binary, since the forced reserve is irreversible for
+// the life of the process.
+func TestExceptionReserveSurvivesShrink(t *testing.T) {
+	if os.Getenv("TEST_EXCEPTION_RESERVE_SURVIVES_SHRINK") != "1" {
+		runSelfInSubprocess(t, "TestExceptionReserveSurvivesShrink", "TEST_EXCEPTION_RESERVE_SURVIVES_SHRINK")
+		return
+	}
+	// 30000 rather than a round number: stackMinAlloc rounds stackMin+
+	// reserve up to the next power of two, so a reserve that is itself
+	// close to a power of two gives the floor far more slack than the
+	// reserve alone needs and never lets a stack get close enough to
+	// shrinkstack's limits to exercise the bug. This value keeps them
+	// close, the way the real AMX figures in issue 81238 happen to.
+	const reserve = 30000
+	runtime.SetStackSystemReserve(reserve)
+
+	// Grow well past any stack size this is likely to end up at, then
+	// return to a point 7 frames deep (about 8 KiB live), so the
+	// allocation is far larger than its live content and a shrink is
+	// attempted, the same shape as issue 81238's shrink example.
+	const deepTo = 80
+	const parkAt = 6
+	var headroom uintptr
+	var sizes stackSizes
+	runParkedUnderGC(func(ready chan<- struct{}, resume <-chan struct{}) {
+		growDeepReturnToParkPoint(0, deepTo, parkAt, [1024]byte{}, ready, resume, &headroom, &sizes)
+	})
+	sizes.requireShrink(t)
+	if headroom < reserve {
+		t.Fatalf("shrinkstack left %d bytes below SP, want at least the %d-byte reserve", headroom, reserve)
+	}
+}
+
+// runSelfInSubprocess re-executes the test binary to run just test, with
+// env set to 1, and fails if that run does.
+func runSelfInSubprocess(t *testing.T, test, env string) {
+	t.Helper()
+	cmd := testenv.CleanCmdEnv(testenv.Command(t, testenv.Executable(t), "-test.run=^"+test+"$", "-test.v"))
+	cmd.Env = append(cmd.Env, env+"=1")
+	out, err := cmd.CombinedOutput()
+	if err != nil || !strings.Contains(string(out), "--- PASS: "+test) {
+		t.Fatalf("subprocess failed: %v\n%s", err, out)
+	}
+}
+
+// runParkedUnderGC runs goroutine on its own goroutine, waits for it to
+// report (via the ready channel it's given) that it has parked, then gives
+// the GC repeated chances to scan and shrink its stack before closing
+// resume and waiting for it to finish. Waiting for ready first matters:
+// without it, the GC loop could run and return before the new goroutine
+// has even started, scanning nothing worth shrinking.
+func runParkedUnderGC(goroutine func(ready chan<- struct{}, resume <-chan struct{})) {
+	ready := make(chan struct{})
+	resume := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		goroutine(ready, resume)
+		close(done)
+	}()
+	<-ready
+	for range 8 {
+		runtime.GC()
+	}
+	close(resume)
+	<-done
+}
+
+// growDeepReturnToParkPoint recurses down to deepTo, growing the stack
+// allocation, then unwinds back up to parkAt and blocks there on resume.
+// Frames parkAt+1..deepTo have already returned by the time it blocks, but
+// frames 0..parkAt are still live below the blocked call, so this leaves a
+// controlled, nonzero amount of live stack (about parkAt KiB) inside a
+// stack allocation sized for the much deeper descent.
+//
+// *headroom is filled in with the distance from SP to the stack's bottom
+// immediately on resume, by calling the nosplit runtime.StackHeadroom
+// directly rather than through another function: calling anything else
+// first (even a tiny closure) would pass through that function's own
+// entry stack check, which would grow the stack back if it turned out to
+// be undersized and silently repair exactly the bug this measures. That
+// is the scenario from issue 81238: a goroutine resuming at a faulting
+// instruction without first encountering a stack check. The stack sizes
+// around the park are recorded the same way, for the same reason.
+//
+//go:noinline
+func growDeepReturnToParkPoint(cur, deepTo, parkAt int, ballast [1024]byte, ready chan<- struct{}, resume <-chan struct{}, headroom *uintptr, sizes *stackSizes) {
+	if cur < deepTo {
+		growDeepReturnToParkPoint(cur+1, deepTo, parkAt, ballast, ready, resume, headroom, sizes)
+	}
+	if cur == parkAt {
+		sizes.parked = runtime.StackSize()
+		close(ready)
+		<-resume
+		*headroom = runtime.StackHeadroom()
+		sizes.resumed = runtime.StackSize()
+	}
+}
+
+// faultAfterParkPoint is growDeepReturnToParkPoint's counterpart for a real
+// hardware fault instead of a headroom measurement: debug.SetPanicOnFault
+// and the deferred recover are both armed before blocking, so the only
+// things that run between resume unblocking and the fault are the nosplit
+// stack size read and the faulting read itself, inline, with nothing else
+// entered in between. Calling a separate probe function after resume would
+// have the problem described at growDeepReturnToParkPoint: its entry check
+// would run first and could repair an undersized stack before the fault
+// had the chance to land.
+//
+//go:noinline
+//go:nocheckptr
+func faultAfterParkPoint(cur, deepTo, parkAt int, ballast [1024]byte, ready chan<- struct{}, resume <-chan struct{}, sizes *stackSizes) (faulted bool) {
+	if cur < deepTo {
+		faulted = faultAfterParkPoint(cur+1, deepTo, parkAt, ballast, ready, resume, sizes)
+	}
+	if cur == parkAt {
+		old := debug.SetPanicOnFault(true)
+		defer debug.SetPanicOnFault(old)
+		defer func() {
+			if recover() != nil {
+				faulted = true
+			}
+		}()
+		sizes.parked = runtime.StackSize()
+		close(ready)
+		<-resume
+		sizes.resumed = runtime.StackSize()
+		const unmapped = 0x1000
+		_ = *(*byte)(unsafe.Pointer(uintptr(unmapped)))
+	}
+	return faulted
+}

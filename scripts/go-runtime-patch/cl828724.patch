+// The OS reserve below every goroutine stack, the stack guard distance and
+// the minimum stack allocation, in force.
+//
+// They start at the compile-time floors (stackSystem, stackGuard and
+// fixedStack) and may be raised once, before any goroutine stack is
+// allocated, by setStackSystemReserve: some systems need more room below a
+// goroutine's stack than stackSystem grants, and how much is only known at
+// run time. Windows is one: the kernel dispatches every exception on the
+// faulting goroutine's own stack, pushing a CONTEXT whose size depends on
+// the CPU's extended register state (see exceptionStackReserve in
+// os_windows.go).
+//
+// The compile-time stackGuard still applies in two places. The assembly
+// that bootstraps g0 (rt0_go and the thread entry points) sets its guard
+// from const_stackGuard before mstart0 and minit replace it with
+// stackGuardSize, so no architecture's assembly changes for a Windows-only
+// need. And the linker's nosplit check assumes only the floor, which stays
+// valid because stackGuardSize never falls below it.
+var (
+	stackSystemReserve uintptr = stackSystem
+	stackGuardSize     uintptr = stackGuard
+	stackMinAlloc      uint32  = fixedStack
+)
+
+// setStackSystemReserve raises the per-stack OS reserve to n bytes, and with
+// it the stack guard distance and the minimum stack allocation. It must be
+// called from osinit, before the first goroutine stack is allocated, and
+// only raises. Later calls are test-only: they rely on every reader
+// re-deriving its value from the new ones (the next execute resets each
+// goroutine's guard, gfget drops cached stacks of the old size, and the
+// prologue check grows a stack that is now undersized), and on the new
+// reserve being harmless for stacks allocated under the old one.
+func setStackSystemReserve(n uintptr) {
+	n = alignUp(n, 16)
+	if n <= stackSystemReserve {
+		return
+	}
+	stackSystemReserve = n
+	stackGuardSize = stackNosplit + n + abi.StackSmall
+	// Same shape as fixedStack: the smallest power of two that holds the
+	// reserve plus stackMin bytes of Go frames.
+	stackMinAlloc = uint32(round2(int32(stackMin + n)))
+	startingStackSize = stackMinAlloc
+}

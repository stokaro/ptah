+// exceptionStackReserve reports how many bytes below a goroutine's stack
+// pointer Windows may write while dispatching an exception on it.
+//
+// Windows has no alternate signal stack. The kernel pushes an EXCEPTION_RECORD
+// and a CONTEXT onto the faulting thread's stack, and ntdll's dispatcher and
+// the runtime's vectored handler (sigtramp) then run on that same stack until
+// sigtrampgo switches to g0. The CONTEXT is not a fixed size: it carries the
+// extended register state (XSTATE) of every CPU feature the OS has enabled,
+// which is under 2 KiB on a typical client CPU but over 11 KiB on Intel Xeons
+// with AMX, whose 8 KiB tile state is laid out even for threads that never
+// use it. stackSystem's 4 KiB floor was sized for the former. See #81238.
+func exceptionStackReserve() uintptr {
+	// Everything on the stack beyond what InitializeContext counts: the
+	// EXCEPTION_RECORD (152 bytes on amd64 and arm64, 80 on 386), the
+	// alignment the kernel adds to a hardware exception's frame, and the
+	// frames that run below the CONTEXT before sigtrampgo switches to g0
+	// (KiUserExceptionDispatcher, RtlDispatchException,
+	// RtlpCallVectoredHandlers, sigtramp, sigtrampgo). Measured from a real
+	// hardware fault's SP to a local in the first vectored handler, which
+	// stands where sigtramp does, the part beyond the InitializeContext
+	// figure is up to 913 bytes on amd64 (Windows Server 2022 and 2025,
+	// with and without AMX), up to 1087 bytes on arm64 (Windows 11 24H2 on
+	// a Cobalt 100 with SVE enabled), and 309 bytes on 386. A fault at the
+	// bottom of a nosplit chain has exactly the reserve to spare, so this
+	// must cover the worst case: 2048 leaves at least 960 bytes for
+	// sigtramp's and sigtrampgo's own frames on each of the three, and
+	// rounds up for other ntdll builds.
+	const dispatchOverhead = 2048
+
+	// With a nil buffer InitializeContext fails with ERROR_INSUFFICIENT_BUFFER
+	// and stores the size the current CPU's full context needs, XSTATE
+	// included, in n; that is the size the kernel will push. Any other
+	// outcome leaves n undefined, so it must not be trusted.
+	//
+	// Two failures mean that this host has no extended state to push, so the
+	// legacy flags, which every supported Windows version accepts, report the
+	// right size: ERROR_NOT_SUPPORTED, when the kernel defines CONTEXT_XSTATE
+	// but cannot provide it (observed for a defined-but-unavailable flag bit
+	// on amd64); and, on arm64 only, ERROR_INVALID_PARAMETER, because kernels
+	// before Windows 11 24H2 do not define CONTEXT_ARM64_XSTATE at all and
+	// reject the bit the way they reject any undefined one (observed for an
+	// undefined bit on both architectures). On amd64 and 386 the bit has
+	// been defined for as long as Go has run there, so ERROR_INVALID_PARAMETER
+	// can only mean a bug. Anything else is unexpected and fatal, rather than
+	// silently keeping the compile-time floor on a host where it may not be
+	// enough.
+	n, errno := initializeContextSize(windows.CONTEXT_ALL | windows.CONTEXT_XSTATE)
+	switch {
+	case errno == 0:
+	case errno == windows.ERROR_NOT_SUPPORTED,
+		errno == windows.ERROR_INVALID_PARAMETER && GOARCH == "arm64":
+		n, errno = initializeContextSize(windows.CONTEXT_ALL)
+	}
+	if errno != 0 {
+		print("runtime: InitializeContext failed; errno=", errno, "\n")
+		throw("InitializeContext failed")
+	}
+	return uintptr(n) + dispatchOverhead
+}
+
+// initializeContextSize calls InitializeContext with a nil buffer to learn
+// how many bytes a CONTEXT with the given flags needs. Per its documented
+// contract, that succeeds only in the sense of failing with
+// ERROR_INSUFFICIENT_BUFFER and reporting the size; any other outcome
+// leaves the size undefined, so this reports it as an error instead of
+// guessing.
+func initializeContextSize(contextFlags uint32) (n uint32, errno uint32) {
+	stdcall(_InitializeContext, 0, uintptr(contextFlags), 0, uintptr(unsafe.Pointer(&n)))
+	if errno = getlasterror(); errno != windows.ERROR_INSUFFICIENT_BUFFER {
+		return 0, errno
+	}
+	return n, 0
+}

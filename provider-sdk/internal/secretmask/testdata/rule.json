{
  "replacement": "***",
  "mask": [
    {"name": "the user info of a URL", "secrets": ["x"], "users": ["app"],
     "text": "connect to postgres://app:x@localhost/execute failed",
     "want": "connect to postgres://app:***@localhost/execute failed"},
    {"name": "the user info of a DSN", "secrets": ["x"], "users": ["app"],
     "text": "cannot parse `app:x@tcp(localhost:3306)/execute`",
     "want": "cannot parse `app:***@tcp(localhost:3306)/execute`"},
    {"name": "a URL with no user name", "secrets": ["x"], "users": ["app"],
     "text": "postgres://:x@localhost/execute",
     "want": "postgres://:***@localhost/execute"},
    {"name": "an escaped password in a quoted URL", "secrets": ["p%40s"], "users": ["app"],
     "text": "connect to postgres://app:p%40s@localhost/shop",
     "want": "connect to postgres://app:***@localhost/shop"},
    {"name": "a password the text escapes", "secrets": ["p@s"], "users": ["app"],
     "text": "connect to postgres://app:p%40s@localhost/shop",
     "want": "connect to postgres://app:***@localhost/shop"},
    {"name": "escapes in lower case", "secrets": ["p/ss"], "users": ["app"],
     "text": "connect to postgres://app:p%2fss@localhost/shop",
     "want": "connect to postgres://app:***@localhost/shop"},
    {"name": "a space written as a plus", "secrets": ["a b"], "users": ["app"],
     "text": "query password=a+b&sslmode=disable",
     "want": "query password=***&sslmode=disable"},
    {"name": "an escaped percent sign", "secrets": ["%41"], "users": ["app"],
     "text": "postgres://app:%2541@localhost/shop and postgres://app:%41@localhost/shop",
     "want": "postgres://app:***@localhost/shop and postgres://app:***@localhost/shop"},
    {"name": "a keyword", "secrets": ["x"], "users": ["app"],
     "text": "host=localhost password=x dbname=execute",
     "want": "host=localhost password=*** dbname=execute"},
    {"name": "a keyword in capitals at the end of the text", "secrets": ["pw"], "users": ["app"],
     "text": "export PGPASSWORD=pw",
     "want": "export PGPASSWORD=***"},
    {"name": "a variable with an underscore", "secrets": ["pw"], "users": ["app"],
     "text": "MYSQL_PWD=pw\n",
     "want": "MYSQL_PWD=***\n"},
    {"name": "a quoted keyword value", "secrets": ["x"], "users": ["app"],
     "text": "options: Pwd='x' Database='execute'",
     "want": "options: Pwd='***' Database='execute'"},
    {"name": "an ODBC value in braces", "secrets": ["x"], "users": ["app"],
     "text": "server=db;pwd={x};database=execute",
     "want": "server=db;pwd={***};database=execute"},
    {"name": "a dotted server option", "secrets": ["k1"], "users": ["app"],
     "text": "-c app.jwt_secret=k1",
     "want": "-c app.jwt_secret=***"},
    {"name": "spaces around the equals sign", "secrets": ["x"], "users": ["app"],
     "text": "password = x;",
     "want": "password = ***;"},
    {"name": "a keyword and a colon", "secrets": ["ab"], "users": ["app"],
     "text": "password: ab",
     "want": "password: ***"},
    {"name": "a JSON key", "secrets": ["ab"], "users": ["app"],
     "text": "{\"user\": \"app\", \"password\": \"ab\"}",
     "want": "{\"user\": \"app\", \"password\": \"***\"}"},
    {"name": "an escaped JSON key", "secrets": ["ab"], "users": ["app"],
     "text": "\"{\\\"password\\\":\\\"ab\\\"}\"",
     "want": "\"{\\\"password\\\":\\\"***\\\"}\""},
    {"name": "a value before a colon", "secrets": ["x"], "users": ["app"],
     "text": "parse postgres://app@h/execute?sslmode=disable&password=x: bad",
     "want": "parse postgres://app@h/execute?sslmode=disable&password=***: bad"},
    {"name": "a value before a comment", "secrets": ["ab"], "users": ["app"],
     "text": "PGPASSWORD=ab# from the vault",
     "want": "PGPASSWORD=***# from the vault"},
    {"name": "a value before an escape", "secrets": ["ab"], "users": ["app"],
     "text": "password=ab\\nnext",
     "want": "password=***\\nnext"},
    {"name": "a user and a password before a space", "secrets": ["ab"], "users": ["app"],
     "text": "curl -u app:ab https://h/",
     "want": "curl -u app:*** https://h/"},
    {"name": "the last field of a password file", "secrets": ["ab"], "users": ["app"],
     "text": "localhost:5432:shop:app:ab",
     "want": "localhost:5432:shop:app:***"},
    {"name": "the last field of a password file, before a new line", "secrets": ["ab"], "users": ["app"],
     "text": "localhost:5432:shop:app:ab\nnext",
     "want": "localhost:5432:shop:app:***\nnext"},
    {"name": "a user and a password after a slash", "secrets": ["ab"], "users": ["app"],
     "text": "sqlplus app/ab@h:1521/FREEPDB1",
     "want": "sqlplus app/***@h:1521/FREEPDB1"},
    {"name": "the MySQL client's -p", "secrets": ["ab"], "users": ["app"],
     "text": "+ mysql -uapp -pab shop",
     "want": "+ mysql -uapp -p*** shop"},
    {"name": "a --password option", "secrets": ["ab"], "users": ["app"],
     "text": "pg_dump --password ab --host h",
     "want": "pg_dump --password *** --host h"},
    {"name": "a bearer token", "secrets": ["ab"], "users": ["app"],
     "text": "Authorization: Bearer ab",
     "want": "Authorization: Bearer ***"},
    {"name": "a role password", "secrets": ["ab"], "users": ["app"],
     "text": "CREATE ROLE app LOGIN PASSWORD 'ab'",
     "want": "CREATE ROLE app LOGIN PASSWORD '***'"},
    {"name": "a role password in an escape string", "secrets": ["ab"], "users": ["app"],
     "text": "CREATE ROLE app LOGIN PASSWORD E'ab'",
     "want": "CREATE ROLE app LOGIN PASSWORD E'***'"},
    {"name": "an account password", "secrets": ["ab"], "users": ["app"],
     "text": "ALTER USER app IDENTIFIED BY \"ab\"",
     "want": "ALTER USER app IDENTIFIED BY \"***\""},
    {"name": "each place it stands", "secrets": ["ptah"], "users": ["app"],
     "text": "ptah: postgres://ptah:ptah@localhost/ptah and password=ptah",
     "want": "ptah: postgres://ptah:***@localhost/ptah and password=***"},
    {"name": "repeated", "secrets": ["Pa55wordX9"], "users": ["app"],
     "text": "login with Pa55wordX9 failed; retried Pa55wordX9",
     "want": "login with *** failed; retried ***"},
    {"name": "five characters, the shortest taken out", "secrets": ["Xk9Lm"], "users": ["app"],
     "text": "lookup Xk9Lm: no such host",
     "want": "lookup ***: no such host"},
    {"name": "punctuation inside the secret", "secrets": ["/tmp/Xk9Lm"], "users": ["app"],
     "text": "open /tmp/Xk9Lm: no such file",
     "want": "open ***: no such file"},
    {"name": "a value of a setting that is no secret", "secrets": ["Xk9Lm"], "users": ["app"],
     "text": "database=Xk9Lm@localhost/shop",
     "want": "database=***@localhost/shop"},
    {"name": "the longer secret first", "secrets": ["abcde", "abcde/fghij"], "users": ["app"],
     "text": "read abcde/fghij and abcde",
     "want": "read *** and ***"},
    {"name": "five characters wider than a byte", "secrets": ["äöüßé"], "users": ["app"],
     "text": "login with äöüßé failed",
     "want": "login with *** failed"},
    {"name": "inside a longer word", "secrets": ["Pa55wordX9"], "users": ["app"],
     "text": "database Pa55wordX9db",
     "want": "database ***db"},
    {"name": "before a digit", "secrets": ["Pa55wordX9"], "users": ["app"],
     "text": "database Pa55wordX99",
     "want": "database ***9"},
    {"name": "after an underscore", "secrets": ["Pa55wordX9"], "users": ["app"],
     "text": "database old_Pa55wordX9",
     "want": "database old_***"},
    {"name": "after an escape a program wrote", "secrets": ["Srv9Kq2Lm"], "users": ["app"],
     "text": "{\"line\": \"a\\nSrv9Kq2Lm\"}",
     "want": "{\"line\": \"a\\n***\"}"},
    {"name": "glued to an option", "secrets": ["Tok3nValue9"], "users": ["app"],
     "text": "+ dump -xTok3nValue9",
     "want": "+ dump -x***"},
    {"name": "a letter of a word", "secrets": ["x"], "users": ["app"],
     "text": "failed to connect to `user=app database=execute`",
     "want": "failed to connect to `user=app database=execute`"},
    {"name": "the product's name", "secrets": ["ptah"], "users": ["app"],
     "text": "ptah: failed to connect to `user=ptah database=ptah`",
     "want": "ptah: failed to connect to `user=ptah database=ptah`"},
    {"name": "a short secret that stands as a word", "secrets": ["YES"], "users": ["app"],
     "text": "the answer is YES, try again",
     "want": "the answer is YES, try again"},
    {"name": "four characters wider than a byte", "secrets": ["äöüß"], "users": ["app"],
     "text": "login with äöüß failed",
     "want": "login with äöüß failed"},
    {"name": "a keyword value the secret only begins", "secrets": ["x"], "users": ["app"],
     "text": "password=xyz",
     "want": "password=xyz"},
    {"name": "a keyword value the secret begins before punctuation", "secrets": ["p@"], "users": ["app"],
     "text": "password=p@ss",
     "want": "password=p@ss"},
    {"name": "a setting that is no secret", "secrets": ["x"], "users": ["app"],
     "text": "user=x database=x",
     "want": "user=x database=x"},
    {"name": "a colon before a separator", "secrets": ["x"], "users": ["app"],
     "text": "columns a:x, b are ambiguous",
     "want": "columns a:x, b are ambiguous"},
    {"name": "a label before a colon", "secrets": ["x"], "users": ["app"],
     "text": "column a:x is ambiguous",
     "want": "column a:x is ambiguous"},
    {"name": "a port", "secrets": ["1"], "users": ["app"],
     "text": "127.0.0.1:1 (127.0.0.1): dial error",
     "want": "127.0.0.1:1 (127.0.0.1): dial error"},
    {"name": "a port of four digits", "secrets": ["5432"], "users": ["app"],
     "text": "dial 10.0.0.5:5432 (db) failed",
     "want": "dial 10.0.0.5:5432 (db) failed"},
    {"name": "a word before a colon", "secrets": ["x"], "users": ["app"],
     "text": "sql:x statement failed",
     "want": "sql:x statement failed"},
    {"name": "a time", "secrets": ["34"], "users": ["app"],
     "text": "12:34 failed",
     "want": "12:34 failed"},
    {"name": "an address of two colons", "secrets": ["1"], "users": ["app"],
     "text": "host ::1 down",
     "want": "host ::1 down"},
    {"name": "another user before a colon", "secrets": ["ab"], "users": ["app"],
     "text": "curl -u bob:ab https://h/",
     "want": "curl -u bob:ab https://h/"},
    {"name": "a user name that ends a longer word", "secrets": ["ab"], "users": ["app"],
     "text": "curl -u myapp:ab https://h/",
     "want": "curl -u myapp:ab https://h/"},
    {"name": "an option value the secret only begins", "secrets": ["ab"], "users": ["app"],
     "text": "cp -pabc dest",
     "want": "cp -pabc dest"},
    {"name": "an escape that spells another character", "secrets": ["x"], "users": ["app"],
     "text": "postgres://app:%79@localhost/shop",
     "want": "postgres://app:%79@localhost/shop"},
    {"name": "an escape cut short", "secrets": ["@"], "users": ["app"],
     "text": "postgres://app:%4@localhost/shop",
     "want": "postgres://app:%4@localhost/shop"},
    {"name": "an empty secret", "secrets": [""], "users": ["app"],
     "text": "connect to postgres://app:@localhost/shop",
     "want": "connect to postgres://app:@localhost/shop"},
    {"name": "no secrets", "secrets": [], "users": ["app"],
     "text": "password=x",
     "want": "password=x"},
    {"name": "an escape string that is no password", "secrets": ["ab"], "users": ["app"],
     "text": "SELECT E'ab' AS label",
     "want": "SELECT E'ab' AS label"},
    {"name": "a flag a name holding a secret word sets to a short secret's spelling", "secrets": ["on"], "users": ["app"],
     "text": "useKeyring=on password=on",
     "want": "useKeyring=on password=***"}
  ],

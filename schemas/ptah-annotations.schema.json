        "directive": {
          "const": "ptah:schema:composite"
        }
      },
      "required": [
        "directive",
        "attributes"
      ],
      "type": "object"
    },
    "ptah.schema.constraint": {
      "additionalProperties": false,
      "description": "Declares a table constraint.",
